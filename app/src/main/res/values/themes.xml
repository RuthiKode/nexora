<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.NEXORA" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nx_primary</item>
        <item name="colorOnPrimary">@color/nx_on_primary</item>
        <item name="colorPrimaryContainer">@color/nx_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/nx_on_primary_container</item>
        <item name="colorSecondary">@color/nx_secondary</item>
        <item name="colorOnSecondary">@color/nx_on_secondary</item>
        <item name="colorSecondaryContainer">@color/nx_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/nx_on_secondary_container</item>
        <item name="colorTertiary">@color/nx_secondary</item>
        <item name="android:colorBackground">@color/nx_background</item>
        <item name="colorSurface">@color/nx_background</item>
        <item name="colorOnSurface">@color/nx_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/nx_on_surface_variant</item>
        <item name="colorSurfaceVariant">@color/nx_surface_variant</item>
        <item name="colorOutline">@color/nx_outline</item>
        <item name="colorOutlineVariant">@color/nx_outline_variant</item>
        <item name="colorSurfaceContainerLowest">@color/nx_surface_lowest</item>
        <item name="colorSurfaceContainerLow">@color/nx_surface_low</item>
        <item name="colorSurfaceContainer">@color/nx_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/nx_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/nx_surface_highest</item>
        <item name="colorError">@color/nx_error</item>
        <item name="colorOnError">@color/nx_on_error</item>
        <item name="colorErrorContainer">@color/nx_error_container</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/nx_light_bars</item>
        <item name="android:navigationBarColor">@color/nx_background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/nx_light_bars</item>
        <item name="shapeAppearanceCornerSmall">@style/Shape.Nexora.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.Nexora.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.Nexora.Large</item>
        <item name="materialCardViewStyle">@style/Widget.Nexora.Card</item>
        <item name="textInputStyle">@style/Widget.Nexora.TextInput</item>
        <item name="chipStyle">@style/Widget.Nexora.Chip</item>
        <item name="materialButtonStyle">@style/Widget.Nexora.Button</item>
        <item name="bottomNavigationStyle">@style/Widget.Nexora.BottomNav</item>
        <item name="toolbarStyle">@style/Widget.Nexora.Toolbar</item>
    </style>

    <!-- Launch theme: brand splash until AuthActivity switches to Theme.NEXORA. -->
    <style name="Theme.NEXORA.Splash">
        <item name="android:windowBackground">@drawable/bg_splash</item>
    </style>

    <style name="Shape.Nexora.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>
    <style name="Shape.Nexora.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="Shape.Nexora.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.Nexora.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/Shape.Nexora.Medium</item>
    </style>
    <style name="Widget.Nexora.Card.Tonal">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Nexora.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
    <style name="Widget.Nexora.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Widget.Nexora.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipMinTouchTargetSize">48dp</item>
    </style>

    <style name="Widget.Nexora.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="shapeAppearance">@style/Shape.Nexora.Small</item>
    </style>
    <style name="Widget.Nexora.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="shapeAppearance">@style/Shape.Nexora.Small</item>
    </style>
    <style name="Widget.Nexora.Button.Text" parent="Widget.Material3.Button.TextButton" />

    <style name="Widget.Nexora.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">?attr/colorSurfaceContainerLowest</item>
    </style>

    <style name="Widget.Nexora.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.Nexora.Headline</item>
    </style>

    <!-- Typography -->
    <style name="TextAppearance.Nexora.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.Nexora.Headline" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.Nexora.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.Nexora.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.Nexora.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="TextAppearance.Nexora.Overline" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Reusable view styles -->
    <style name="Nexora.Section" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Nexora.Title</item>
        <item name="android:accessibilityHeading" tools:targetApi="p">true</item>
    </style>
    <style name="Nexora.CardBody" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="Nexora.Badge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelMedium</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="Nexora.Field" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
</resources>
