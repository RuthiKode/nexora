<?xml version="1.0" encoding="utf-8"?>
<!-- Drive detail: header, explainable eligibility card, explainable match card, role/company info,
     stage preview and a sticky Apply bar with the reason when applying is disabled. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout style="@style/Nexora.CardBody">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/logo"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="?attr/colorPrimaryContainer"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Nexora.Headline" />

                                <TextView
                                    android:id="@+id/company"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Nexora.Body"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <ImageButton
                                android:id="@+id/bookmark"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                app:tint="?attr/colorPrimary" />
                        </LinearLayout>

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/info_chips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:id="@+id/deadline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                            app:drawableStartCompat="@drawable/ic_schedule"
                            app:drawableTint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Eligibility -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout style="@style/Nexora.CardBody">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:accessibilityHeading="true"
                                android:text="@string/eligibility"
                                android:textAppearance="@style/TextAppearance.Nexora.Title" />

                            <TextView
                                android:id="@+id/elig_badge"
                                style="@style/Nexora.Badge" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/elig_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAppearance="@style/TextAppearance.Nexora.Body" />

                        <LinearLayout
                            android:id="@+id/criteria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Match score -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/match_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout style="@style/Nexora.CardBody">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.nexora.ui.ChartView
                                android:id="@+id/match_ring"
                                android:layout_width="84dp"
                                android:layout_height="84dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:accessibilityHeading="true"
                                    android:text="@string/match_score"
                                    android:textAppearance="@style/TextAppearance.Nexora.Title" />

                                <TextView
                                    android:id="@+id/match_band"
                                    style="@style/Nexora.Badge"
                                    android:layout_marginTop="6dp" />

                                <TextView
                                    android:id="@+id/match_formula"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:textAppearance="@style/TextAppearance.Nexora.Caption" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/match_bars"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/matched_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/skills_you_have"
                            android:textAppearance="@style/TextAppearance.Nexora.Overline" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/matched_chips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/missing_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/skills_to_build"
                            android:textAppearance="@style/TextAppearance.Nexora.Overline" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/missing_chips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <LinearLayout
                            android:id="@+id/reasons"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/match_disclaimer"
                            android:textAppearance="@style/TextAppearance.Nexora.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- About -->
                <TextView
                    style="@style/Nexora.Section"
                    android:text="@string/about_role" />

                <TextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Nexora.Body"
                    android:lineSpacingMultiplier="1.2" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/required_skills"
                    android:textAppearance="@style/TextAppearance.Nexora.Overline" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/required_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Company -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/company_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout style="@style/Nexora.CardBody">

                        <TextView
                            android:id="@+id/company_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical"
                            android:textAppearance="@style/TextAppearance.Nexora.Title"
                            app:drawableStartCompat="@drawable/ic_business"
                            app:drawableTint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/company_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAppearance="@style/TextAppearance.Nexora.Body" />

                        <Button
                            android:id="@+id/company_site"
                            style="@style/Widget.Nexora.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="-12dp"
                            android:text="@string/visit_website"
                            app:icon="@drawable/ic_link" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stages -->
                <TextView
                    style="@style/Nexora.Section"
                    android:text="@string/recruitment_stages" />

                <LinearLayout
                    android:id="@+id/stages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/state"
            layout="@layout/view_state" />
    </FrameLayout>

    <!-- Sticky apply bar -->
    <LinearLayout
        android:id="@+id/apply_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLowest"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/apply_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textAppearance="@style/TextAppearance.Nexora.Caption"
            android:visibility="gone" />

        <Button
            android:id="@+id/apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/apply_now" />
    </LinearLayout>
</LinearLayout>
