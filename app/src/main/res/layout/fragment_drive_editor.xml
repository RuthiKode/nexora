<?xml version="1.0" encoding="utf-8"?>
<!-- Officer drive editor: details, criteria, skills, preparation focus, deadline, stages; save/publish/close. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/e_status"
                style="@style/Nexora.Badge" />

            <TextView
                style="@style/Nexora.Section"
                android:text="@string/drive_details" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/e_company_layout"
                style="@style/Widget.Nexora.TextInput.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/company">

                <AutoCompleteTextView
                    android:id="@+id/e_company"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/e_title_layout"
                style="@style/Nexora.Field"
                android:hint="@string/drive_title">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/e_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/e_role_layout"
                    style="@style/Widget.Nexora.TextInput.Dropdown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:hint="@string/role_category">

                    <AutoCompleteTextView
                        android:id="@+id/e_role"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/e_jobtype_layout"
                    style="@style/Widget.Nexora.TextInput.Dropdown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="12dp"
                    android:layout_weight="1"
                    android:hint="@string/job_type">

                    <AutoCompleteTextView
                        android:id="@+id/e_jobtype"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/e_location_layout"
                    style="@style/Nexora.Field"
                    android:layout_width="0dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:hint="@string/location"
                    app:startIconDrawable="@drawable/ic_place">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/e_location"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/e_package_layout"
                    style="@style/Nexora.Field"
                    android:layout_width="0dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:hint="@string/package_lpa"
                    app:suffixText="LPA">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/e_package"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/e_desc_layout"
                style="@style/Nexora.Field"
                android:hint="@string/description">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/e_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Nexora.Section"
                android:text="@string/eligibility_criteria" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/e_cgpa_layout"
                    style="@style/Nexora.Field"
                    android:layout_width="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:hint="@string/min_cgpa">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/e_cgpa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/e_backlogs_layout"
                    style="@style/Nexora.Field"
                    android:layout_width="0dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:hint="@string/max_backlogs">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/e_backlogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/eligible_branches"
                android:textAppearance="@style/TextAppearance.Nexora.Overline" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/e_branches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/graduation_years"
                android:textAppearance="@style/TextAppearance.Nexora.Overline" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/e_years"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/e_criteria_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Nexora.Caption"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <TextView
                style="@style/Nexora.Section"
                android:text="@string/skills_and_focus" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/e_skill_layout"
                style="@style/Nexora.Field"
                android:layout_marginTop="0dp"
                android:hint="@string/add_required_skill"
                app:endIconContentDescription="@string/add"
                app:endIconDrawable="@drawable/ic_add"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/e_skill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/e_skills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/prep_focus"
                android:textAppearance="@style/TextAppearance.Nexora.Overline" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/e_focus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Nexora.Section"
                android:text="@string/deadline" />

            <Button
                android:id="@+id/e_deadline"
                style="@style/Widget.Nexora.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_schedule" />

            <TextView
                android:id="@+id/e_deadline_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Nexora.Caption"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <TextView
                style="@style/Nexora.Section"
                android:text="@string/recruitment_stages" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stages_help"
                android:textAppearance="@style/TextAppearance.Nexora.Caption" />

            <LinearLayout
                android:id="@+id/e_stages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/e_add_stage"
                style="@style/Widget.Nexora.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_stage"
                app:icon="@drawable/ic_add" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLowest"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/e_save"
            style="@style/Widget.Nexora.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:text="@string/save_draft" />

        <Button
            android:id="@+id/e_publish"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/publish" />
    </LinearLayout>
</LinearLayout>
