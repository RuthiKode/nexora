<?xml version="1.0" encoding="utf-8"?>
<!-- Student home: greeting, verification prompt, readiness ring, eligible drives, closing soon, latest announcement. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Nexora.Display" />

            <TextView
                android:id="@+id/greeting_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Nexora.Caption" />


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/readiness_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    style="@style/Nexora.CardBody"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.nexora.ui.ChartView
                        android:id="@+id/readiness_ring"
                        android:layout_width="96dp"
                        android:layout_height="96dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/placement_readiness"
                            android:textAppearance="@style/TextAppearance.Nexora.Title" />

                        <TextView
                            android:id="@+id/readiness_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxLines="3"
                            android:ellipsize="end"
                            android:textAppearance="@style/TextAppearance.Nexora.Body"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/view_dashboard"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Career Action Plan: ranked next steps from CareerActionEngine. -->
            <TextView
                style="@style/Nexora.Section"
                android:text="@string/next_steps" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    style="@style/Nexora.CardBody"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/actions_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="4dp"
                        android:textAppearance="@style/TextAppearance.Nexora.Caption"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/actions_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Nexora.Section"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/eligible_for_you" />

                <Button
                    android:id="@+id/see_all"
                    style="@style/Widget.Nexora.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/see_all" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/eligible_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/eligible_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Nexora.Caption"
                android:visibility="gone" />

            <TextView
                style="@style/Nexora.Section"
                android:text="@string/closing_soon" />

            <LinearLayout
                android:id="@+id/closing_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/closing_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nothing_closing"
                android:textAppearance="@style/TextAppearance.Nexora.Caption"
                android:visibility="gone" />

            <TextView
                style="@style/Nexora.Section"
                android:text="@string/latest_announcement" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/announcement_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout style="@style/Nexora.CardBody">

                    <TextView
                        android:id="@+id/ann_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Nexora.Title" />

                    <TextView
                        android:id="@+id/ann_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:textAppearance="@style/TextAppearance.Nexora.Body" />

                    <TextView
                        android:id="@+id/ann_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.Nexora.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/state"
        layout="@layout/view_state" />
</FrameLayout>
