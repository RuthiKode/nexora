<?xml version="1.0" encoding="utf-8"?>
<!-- One editable recruitment stage. The first and last stages are fixed (no rename/move/remove). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        style="@style/Nexora.CardBody"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/s_index"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="?attr/colorPrimaryContainer"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorOnPrimaryContainer" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/s_name_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="@string/stage_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/s_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/s_up"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/move_up"
                android:src="@drawable/ic_arrow_up" />

            <ImageButton
                android:id="@+id/s_down"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/move_down"
                android:src="@drawable/ic_arrow_down" />

            <ImageButton
                android:id="@+id/s_remove"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/remove_stage"
                android:src="@drawable/ic_delete"
                app:tint="?attr/colorError" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/s_schedule_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/s_date"
                style="@style/Widget.Nexora.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:textSize="13sp"
                app:icon="@drawable/ic_schedule" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/s_venue_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="@string/venue_or_link">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/s_venue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
