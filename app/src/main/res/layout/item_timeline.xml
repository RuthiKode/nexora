<?xml version="1.0" encoding="utf-8"?>
<!-- One recruitment stage in a vertical timeline: done ✓ / current ● / upcoming ○ / failed ✗. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/tl_dot"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_circle"
            android:importantForAccessibility="no"
            android:padding="6dp" />

        <View
            android:id="@+id/tl_line"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tl_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingTop="3dp"
                android:textAppearance="@style/TextAppearance.Nexora.Title" />

            <TextView
                android:id="@+id/tl_badge"
                style="@style/Nexora.Badge" />
        </LinearLayout>

        <TextView
            android:id="@+id/tl_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Nexora.Caption" />

        <TextView
            android:id="@+id/tl_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Nexora.Body"
            android:textStyle="italic" />
    </LinearLayout>
</LinearLayout>
